# Copiá a .env y completá con la config de tu app web de Firebase (Configuración del proyecto > Tus apps)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Opcional: si lo completás, la app pide login con Google y solo deja entrar a este email.
# Vacío = sin login (las reglas de firestore.rules deben estar abiertas).
PUBLIC_ALLOWED_EMAIL=
