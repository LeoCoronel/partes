# Copiá a .env y completá con la config de tu app web de Firebase (Configuración del proyecto > Tus apps)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Opcional: solo este email puede entrar a la app (las reglas de Firestore igual lo exigen)
PUBLIC_ALLOWED_EMAIL=
